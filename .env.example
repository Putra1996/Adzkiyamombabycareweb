PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Tasya Hanifah
# ALLOWED_ORIGINS tidak wajib: same-origin, domain Vercel, dan GitHub Pages sudah diizinkan otomatis.
# ALLOWED_ORIGINS=https://domain-lain.example
# DATABASE_URL=postgresql://user:password@host:5432/database
# Batas waktu satu query PostgreSQL (ms, opsional, bawaan 20000). Mencegah
# request menggantung saat koneksi database setengah putus.
# PG_QUERY_TIMEOUT_MS=20000
# CRON_SECRET=acak-panjang
